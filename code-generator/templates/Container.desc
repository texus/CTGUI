inherits Widget

function void add(Widget widget, string widgetName = '')
const-function Widget get(string widgetName)
const-function List<Widget> getWidgets()
function bool remove(Widget widget)
function void removeAllWidgets()

const-throwing-function void saveWidgetsToFile(string filename)

function void moveWidgetToFront(Widget widget)
function void moveWidgetToBack(Widget widget)
function size_t moveWidgetForward(Widget widget)
function size_t moveWidgetBackward(Widget widget)

function bool setWidgetIndex(Widget widget, size_t index)
const-function int getWidgetIndex(Widget widget)

get-property Widget FocusedChild
get-property Widget FocusedLeaf
const-function Widget getWidgetAtPos(Vector2f pos, bool recursive)

function bool focusNextWidget(bool recursive = true)
function bool focusPreviousWidget(bool recursive = true)

get-property Vector2f InnerSize
get-property Vector2f ChildWidgetsOffset
