inherits Widget

enum Policy { Automatic, Always, Never }

/// @brief Renderer containing properties that determine how the widget is displayed
property-widget-renderer ScrollbarRenderer

property uint ViewportSize
property uint Maximum
property uint Value
property uint ScrollAmount
property ScrollbarPolicy Policy
property Orientation Orientation

const-function bool isShown()
const-function uint getMaxValue()
const-function float getDefaultWidth()

signal UInt(value) ValueChange ValueChanged
