inherits Container

enum TabAlign { Top, Bottom }

/// @brief Renderer containing properties that determine how the tabs part of the widget is displayed
property-widget-renderer TabsRenderer Tabs

function void select(size_t index)

get-property size_t PanelCount

get-property int SelectedIndex

const-function string getTabText(size_t index)

function bool changeTabText(size_t index, string text)

property float TabFixedSize
property TabAlign TabAlignment

function void setTabsHeight(float height)
function void setTabsHeightFromLayout setTabsHeight(Layout layout)

function bool removeTabWithName removeTab(string text)
function bool removeTabWithIndex removeTab(size_t index)

signal Int(index) SelectionChange SelectionChanged
signal TabSelectionChanging(index,vetoed) SelectionChanging SelectionChanging
