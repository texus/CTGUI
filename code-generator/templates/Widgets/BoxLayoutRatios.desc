abstract-class
inherits BoxLayout

function void add(Widget widget, float ratio, string widgetName)
function void insert(size_t index, Widget widget, float ratio, string widgetName)

function void addSpace(float ratio)
function void insertSpace(size_t index, float ratio)

function bool setRatio(Widget widget, float ratio)
function bool setRatioAtIndex setRatio(size_t index, float ratio)

const-function float getRatio(Widget widget)
const-function float getRatioAtIndex getRatio(size_t index)
