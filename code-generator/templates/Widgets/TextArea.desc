inherits Widget

/// @brief Renderer containing properties that determine how the widget is displayed
property-widget-renderer TextAreaRenderer

property string Text

function void addText(string text)

property string DefaultText

function void setSelectedText(size_t selectionStartIndex, size_t selectionEndIndex)
const-function string getSelectedText()
const-function size_t getSelectionStart()
const-function size_t getSelectionEnd()

property size_t MaximumCharacters
property string TabString
property size_t CaretPosition

const-function size_t getCaretLine()
const-function size_t getCaretColumn()

property-bool-is ReadOnly

property ScrollbarPolicy VerticalScrollbarPolicy
property ScrollbarPolicy HorizontalScrollbarPolicy

property uint VerticalScrollbarValue
property uint HorizontalScrollbarValue

function void enableMonospacedFontOptimization(bool enable)

const-function size_t getLinesCount()
