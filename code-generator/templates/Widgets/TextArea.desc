inherits Widget
inherits DualScrollbarChildInterface

/// @brief Renderer containing properties that determine how the widget is displayed
property-widget-renderer TextAreaRenderer

property string Text

function void addText(string text)

property string DefaultText

function void setSelectedText(size_t selectionStartIndex, size_t selectionEndIndex)
get-property string SelectedText
get-property size_t SelectionStart
get-property size_t SelectionEnd

property size_t MaximumCharacters
property string TabString
property size_t CaretPosition

get-property size_t CaretLine
get-property size_t CaretColumn

property-bool-is ReadOnly

function void enableMonospacedFontOptimization(bool enable = true)

get-property size_t LinesCount

signal String(text) TextChange TextChanged
signal SelectionChange SelectionChanged
signal CaretPositionChange CaretPositionChanged
