inherits SubwidgetContainer

/// @brief Renderer containing properties that determine how the spin buttons part of the widget is displayed
property-widget-renderer SpinButtonRenderer SpinButton

/// @brief Renderer containing properties that determine how the edit box part of the widget is displayed
property-widget-renderer EditBoxRenderer SpinText

function bool setValue(float value)
const-function float getValue()

property float Minimum
property float Maximum
property float Step
property uint DecimalPlaces
property float SpinButtonWidth
