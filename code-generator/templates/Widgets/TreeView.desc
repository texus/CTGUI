inherits Widget
inherits DualScrollbarChildInterface

/// @brief Renderer containing properties that determine how the widget is displayed
property-widget-renderer TreeViewRenderer

property uint ItemHeight

function bool addItem(List<string> hierarchy, bool createParents)
function bool changeItem(List<string> hierarchy, string leafText)

function void expand(List<string> hierarchy)
function void collapse(List<string> hierarchy)

function void expandAll()
function void collapseAll()

function void deselectItem()
function void removeAllItems()

const-function List<string> getSelectedItem()
const-function List<string> getHoveredItem()

function bool setItemIndexInParent(List<string> hierarchy, size_t index)
const-function int getItemIndexInParent(List<string> hierarchy)

function bool selectItem(List<string> hierarchy)
function bool removeItem(List<string> hierarchy, bool removeParentsWhenEmpty)

signal ItemHierarchy(hierarchy) ItemSelect ItemSelected
signal ItemHierarchy(hierarchy) DoubleClick DoubleClicked
signal ItemHierarchy(hierarchy) Expand Expanded
signal ItemHierarchy(hierarchy) Collapse Collapsed
signal ItemHierarchy(hierarchy) RightClick RightClicked
