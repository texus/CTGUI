inherits Widget

/// @brief Renderer containing properties that determine how the widget is displayed
property-widget-renderer TabsRenderer

property bool AutoSize

function size_t add(string text, bool select)
function void insert(size_t index, string text, bool select)
const-function string getText(size_t index)
function bool changeText(size_t index, string text)

function void deselect()
function void removeAll()

const-function string getSelected()
const-function int getSelectedIndex()
const-function int getHoveredIndex()

const-function size_t getTabsCount()

function void setTabVisible(size_t index, bool visible)
const-function bool getTabVisible(size_t index)

function void setTabEnabled(size_t index, bool visible)
const-function bool getTabEnabled(size_t index)

property float MaximumTabWidth
property float MinimumTabWidth

function bool selectByText select(string text)
function bool selectByIndex select(size_t index)

function bool removeByText remove(string text)
function bool removeByIndex remove(size_t index)

signal String(tabText) TabSelect TabSelected
